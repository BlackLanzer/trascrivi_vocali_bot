# --- Required secrets ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
# Deepgram API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Optional configuration (defaults shown) ---
# Transcription backend. Only "deepgram" is implemented today.
TRANSCRIPTION_PROVIDER=deepgram
# How updates are received. Only "polling" is implemented.
RUN_MODE=polling
# File listing admin Telegram user IDs (one per line).
ADMINS_FILE=config/admins.txt
# SQLite database location.
DB_PATH=data/bot.db
# Defaults applied to each user on first use (changeable via /settings).
DEFAULT_MODEL=nova-3
DEFAULT_LANGUAGE=it
DEFAULT_STREAMING=false
# Per-minute rate used only for the admin /debug cost estimate (not billed).
# Per-model prices are shown in the model picker; this is the fallback.
DEEPGRAM_PRICE_PER_MINUTE=0.0043

# --- Summarization via OpenRouter (optional) ---
# Leave OPENROUTER_API_KEY empty to disable the "Riassumi" button entirely.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default summarization model (per-user selectable via /settings). Pick any
# slug from https://openrouter.ai/models.
DEFAULT_SUMMARY_MODEL=deepseek/deepseek-chat

# --- Audio + transcript cache ---
# Re-sending the same audio with the same model/language reuses the result.
CACHE_DIR=data/cache
CACHE_RETENTION_DAYS=7
CACHE_CLEANUP_INTERVAL_HOURS=6

# --- Logging ---
# Logs go to stdout and to a rotating file under LOG_DIR.
LOG_LEVEL=INFO
LOG_DIR=data/logs
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
