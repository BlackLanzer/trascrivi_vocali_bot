# --- Required secrets ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
# Deepgram API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your-deepgram-api-key

# --- Optional configuration (defaults shown) ---
# Transcription backend. Only "deepgram" is implemented today.
TRANSCRIPTION_PROVIDER=deepgram
# How updates are received. Only "polling" is implemented.
RUN_MODE=polling
# File listing admin Telegram user IDs (one per line).
ADMINS_FILE=config/admins.txt
# SQLite database location.
DB_PATH=data/bot.db
# Defaults applied to each user on first use (changeable via /settings).
DEFAULT_MODEL=nova-3
DEFAULT_LANGUAGE=it
DEFAULT_STREAMING=false
# Per-minute rate used only for the admin /debug cost estimate (not billed).
DEEPGRAM_PRICE_PER_MINUTE=0.0043
